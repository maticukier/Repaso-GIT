{
  "name": "horda-gates",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && npm run validate && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-levels.ts",
    "cap:sync": "npm run build && cap sync android",
    "assets": "tsx scripts/generate-assets.ts",
    "android:open": "cap open android",
    "screenshots": "tsx scripts/store-screenshots.ts",
    "perf": "tsx scripts/perf-audit.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/preferences": "8.0.1",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/node": "22.20.5",
    "playwright": "1.56.1",
    "sharp": "0.35.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
